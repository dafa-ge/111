# 复制为 .env 后按需修改。不填也能跑，所有项都有默认值（见 app/rag/config.py）

# ---- 文档目录 ----
# 默认用仓库自带的 demo_docs；指向自己的资料目录时填绝对路径
# RAG_DOCS_DIR=D:\my\documents

# ---- Ollama ----
RAG_OLLAMA_URL=http://127.0.0.1:11434
RAG_EMBED_MODEL=bge-m3:latest
RAG_LLM_MODEL=qwen3:4b
RAG_NUM_CTX=8192
RAG_NUM_PREDICT=4096

# ---- 检索阈值（改之前先看 docs/技术设计.md 的取值依据）----
RAG_MIN_COS_SIM=0.45
RAG_STRONG_COS_SIM=0.60
RAG_MIN_BM25=1.0
RAG_MEMORY_MIN_COS=0.50

# ---- 鉴权 ----
RAG_AUTH_ENABLED=1
RAG_JWT_TTL_HOURS=12

# ---- OpenAI 兼容层（给 Open WebUI 这类前端调用）----
# 部署前务必改成自己的随机串，否则谁都能用这个 Key 冒充任何账号
RAG_OPENWEBUI_KEY=change-me-before-use

# ---- 审计与日志 ----
RAG_LOG_RETENTION=30
RAG_LOG_ANSWER_MAX=500
